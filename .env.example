# 管理员在网页「设置」里填写中转站密钥（写入 data/settings.json，立即生效，无需重启）。
# 界面永不回显已保存的密钥。不要提交本文件填好的密钥。

# 后台中转站（CCAPI）。对外右侧只显示 GPT / Claude / Grok，不展示价格。
# 默认基址 https://api.ccapi.ai/v1（也可改成 https://api.ccapi.us/v1）
CCAPI_API_KEY=
# CCAPI_BASE_URL=https://api.ccapi.ai/v1

# 高级 / 直连（默认 UI 不会切到这三家）
# xAI：https://console.x.ai
# XAI_API_KEY=

# OpenAI：https://platform.openai.com
# OPENAI_API_KEY=

# Anthropic：https://console.anthropic.com
# ANTHROPIC_API_KEY=

# 可选。默认提供商为中转站（ccapi），默认模型 gpt-5.6（第一个 GPT）。
# 若 data/settings.json 已保存 xai/openai/anthropic，高级直连仍可用。
# GROK_MODEL=grok-4.6

# 可选。图像模型；中转站优先走其 /images/generations，否则回退 xAI
# GROK_IMAGE_MODEL=grok-imagine-image-2.0

# 监听地址。默认只本机。手机 / 局域网请设 HOST=0.0.0.0，并务必设置口令。
# 不要把 0.0.0.0 当成默认值。
HOST=127.0.0.1
PORT=8000

# 可选访问口令。设置后除 GET /api/health 外，/api/* 需要
# Authorization: Bearer <口令> 或 cookie kk_token（POST /api/login 写入）。
# ACCESS_TOKEN= 也可作为别名。
# KK_ACCESS_TOKEN=

# 额外允许的 CORS 来源（逗号分隔）。同源始终允许，且带 credentials。
# KK_CORS_ORIGINS=http://192.168.1.10:8000

# 对外公网模式。开启后聊天对访客开放，但禁用 shell/文件/浏览器/MCP，
# 密钥与例程需要管理员口令。本地开发请保持关闭。
# fail-secure：KK_PUBLIC / PUBLIC_MODE / settings.public_mode 任一为真即对外。
# 环境变量为真时，settings.json 的 public_mode:false 关不掉。
# KK_PUBLIC=1
# PUBLIC_MODE=1 也可。

# 对外模式强烈建议设置。未设置时访客能聊，但无人能改密钥（管理接口 403）。
# POST /api/login 只把口令的 sha256 写入 cookie kk_token；哈希不能当 Bearer。
# KK_ACCESS_TOKEN=

# 反代（Caddy / nginx）后面务必打开，限流才认 X-Forwarded-For 最右侧 hop。
# KK_TRUSTED_PROXY=1

# 对外用量（仅 public）。0 = 该项不限制。本地模式不执行配额。
# KK_VISITOR_TOKEN_LIMIT=200000
# KK_GLOBAL_TOKEN_LIMIT=2000000
# KK_VISITOR_COST_CENTS=0
# KK_GLOBAL_COST_CENTS=0

# 逗号分隔的访客 vid 封禁（另可用管理员 PUT /api/bans）。
# KK_BANNED_VIDS=

# 可选。限制允许的 Host（逗号分隔）。未设置则不做额外 Host 检查。
# KK_ALLOWED_HOSTS=example.com,www.example.com

# 加密 data/settings.json 中的 API 密钥（也用于签名用户 cookie）。
# 可以是口令（经 PBKDF2 派生 Fernet 密钥）或现成的 urlsafe Fernet key。
# KK_SECRETS_KEY=

# 允许注册。默认开启；设为 0 关闭。
# KK_ALLOW_SIGNUP=1

# 对外模式默认必须登录才能聊天。本地模式默认不要求。设为 0 可保留匿名访客。
# KK_REQUIRE_ACCOUNT=1
