# 各提供商密钥也可在网页「设置」里填写（写入 data/settings.json，立即生效，无需重启）。
# 界面永不回显已保存的密钥。

# xAI：https://console.x.ai
XAI_API_KEY=

# OpenAI：https://platform.openai.com
# OPENAI_API_KEY=

# Anthropic：https://console.anthropic.com
# ANTHROPIC_API_KEY=

# 可选。默认提供商 xAI，默认模型 grok-4.6
# GROK_MODEL=grok-4.6

# 可选。图像生成仍走 xAI
# GROK_IMAGE_MODEL=grok-imagine-image-2.0
